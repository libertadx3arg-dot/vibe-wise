# Copiar a .env y completar. NUNCA subir .env al repo.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Capa de IA intercambiable: gemini | claude | openai
AI_PROVIDER=gemini
# Nombre exacto del modelo, como figura en tu cuenta (ej. en Google AI Studio). Sin él, se usa la plantilla.
AI_MODEL=
AI_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dirección pública del sitio (para el link al panel en los avisos). En tu compu: http://localhost:4321
PUBLIC_SITE_URL=

PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

ADMIN_EMAIL=
PUBLIC_WHATSAPP_NUMERO=

# Email del administrador (vos). Solo este email entra al panel /admin.
# (ADMIN_EMAIL ya está arriba: completalo.)
