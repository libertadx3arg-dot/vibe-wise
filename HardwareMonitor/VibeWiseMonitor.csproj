<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Solo para el ícono de la bandeja (NotifyIcon) y los avisos de Windows. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VibeWise.HardwareMonitor</RootNamespace>
    <AssemblyName>VibeWiseMonitor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF + WinForms a la vez provocan nombres ambiguos (Color, Brushes, Point…): se quitan los usings globales de WinForms. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- El SDK de escritorio no lo trae implícito en este proyecto. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

</Project>
