<UserControl x:Class="VibeWise.HardwareMonitor.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VibeWise.HardwareMonitor.Controls">
    <Border Style="{StaticResource Card}" Margin="6" BorderThickness="2"
            BorderBrush="{Binding Frame}" Background="{Binding Tint}">
        <DockPanel LastChildFill="True">
            <!-- Cabecera: título + nivel -->
            <DockPanel DockPanel.Dock="Top">
                <TextBlock DockPanel.Dock="Right" Text="{Binding LevelText}" Foreground="{Binding Accent}"
                           FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding Accent}"
                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="#F1F5F9"/>
            </DockPanel>

            <!-- Historial de 5 minutos con las líneas de aviso y crítico -->
            <c:Sparkline DockPanel.Dock="Bottom" Height="140" Margin="0,10,0,0"
                         Values="{Binding History}" Stroke="{Binding Accent}"
                         Warn="{Binding Warn}" Crit="{Binding Crit}"/>

            <!-- Mínimo, máximo y tendencia de la sesión -->
            <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,8,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="MÍN. SESIÓN" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding MinText}" FontSize="18" FontWeight="SemiBold" Foreground="#E2E8F0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="MÁX. SESIÓN" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding MaxText}" FontSize="18" FontWeight="SemiBold" Foreground="#E2E8F0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="TENDENCIA" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TrendText}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{Binding TrendBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Detail2}" HorizontalAlignment="Center"
                       FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Detail}" HorizontalAlignment="Center"
                       FontSize="13" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>

            <c:ArcGauge MinHeight="190" Margin="0,8"
                        Value="{Binding Value}" Maximum="{Binding Maximum}"
                        Warn="{Binding Warn}" Crit="{Binding Crit}" Unit="{Binding Unit}"
                        Accent="{Binding Accent}"/>
        </DockPanel>
    </Border>
</UserControl>
