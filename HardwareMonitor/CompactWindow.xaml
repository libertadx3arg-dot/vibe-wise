<Window x:Class="VibeWise.HardwareMonitor.CompactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vibe Wise · compacto"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="#E2E8F0">

    <Border x:Name="Root" Margin="8" CornerRadius="16" Padding="18,10,14,10"
            Background="#EE0B1020" BorderBrush="#33FFFFFF" BorderThickness="2"
            Cursor="SizeAll" MouseLeftButtonDown="Root_MouseLeftButtonDown"
            ToolTip="Arrastrá para mover · doble clic para volver a la ventana completa">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <StackPanel MinWidth="64">
                <TextBlock Text="GPU" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                <TextBlock x:Name="GpuText" Text="--" FontSize="28" FontWeight="Bold" Foreground="#38BDF8"/>
            </StackPanel>
            <Rectangle Width="1" Margin="16,4" Fill="#22FFFFFF"/>
            <StackPanel MinWidth="64">
                <TextBlock x:Name="VramCaption" Text="VRAM" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                <TextBlock x:Name="VramText" Text="--" FontSize="28" FontWeight="Bold" Foreground="#38BDF8"/>
            </StackPanel>
            <Rectangle Width="1" Margin="16,4" Fill="#22FFFFFF"/>
            <StackPanel MinWidth="90">
                <TextBlock Text="VENTILADORES" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                <TextBlock x:Name="FanText" Text="--" FontSize="21" FontWeight="Bold" Foreground="#38BDF8"
                           Margin="0,5,0,0"/>
            </StackPanel>
            <TextBlock x:Name="ExpandButton" Text="⤢" FontSize="16" Foreground="#64748B" Cursor="Hand"
                       VerticalAlignment="Top" Margin="14,0,0,0" ToolTip="Volver a la ventana completa"
                       MouseLeftButtonDown="ExpandButton_MouseLeftButtonDown"/>
        </StackPanel>
    </Border>
</Window>
