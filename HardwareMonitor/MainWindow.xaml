<Window x:Class="VibeWise.HardwareMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VibeWise.HardwareMonitor"
        xmlns:m="clr-namespace:VibeWise.HardwareMonitor.Models"
        Title="Vibe Wise · Monitor de GPU"
        Width="1180" Height="820" MinWidth="860" MinHeight="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="#E2E8F0">

    <Window.Resources>
        <DataTemplate DataType="{x:Type m:Metric}">
            <local:MetricCard/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:FanItem}">
            <local:FanBar/>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="22" BorderBrush="#22FFFFFF" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0F1F" Offset="0"/>
                <GradientStop Color="#111A36" Offset="0.55"/>
                <GradientStop Color="#1A1238" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="22,14,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra de título propia: se arrastra desde acá; doble clic = modo compacto -->
            <Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Vibe Wise" FontSize="22" FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#38BDF8" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="Monitor de GPU" FontSize="14" Foreground="#64748B"
                               VerticalAlignment="Bottom" Margin="12,0,0,3"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StartupButton" Style="{StaticResource IconButton}" Content="⏻" Opacity="0.5"
                            ToolTip="Iniciar con Windows (tarea programada)" Click="StartupButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="⚙"
                            ToolTip="Abrir la configuración (umbrales)" Click="ConfigButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="🗒"
                            ToolTip="Abrir el registro de alarmas" Click="LogButton_Click"/>
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="📌" Opacity="0.5"
                            ToolTip="Mantener siempre visible" Click="PinButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="▭"
                            ToolTip="Modo compacto (también: doble clic en el título)" Click="CompactButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="—" ToolTip="Minimizar" Click="Minimize_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="✕"
                            ToolTip="Cerrar (queda en la bandeja del sistema)" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Estado general: Todo OK / Aviso / ALARMA -->
            <Border x:Name="StatusBar" Grid.Row="1" Margin="0,14,0,0" CornerRadius="14" Padding="18,11"
                    Background="#26FFFFFF" Cursor="Hand" MouseLeftButtonUp="StatusBar_Click"
                    ToolTip="Clic: silenciar el sonido de la alarma">
                <DockPanel>
                    <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="14" Height="14"
                             Margin="0,0,12,0" VerticalAlignment="Center" Fill="#64748B"/>
                    <TextBlock x:Name="StatusLabel" DockPanel.Dock="Left" FontSize="19" FontWeight="Bold"
                               Text="Iniciando…" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusHint" DockPanel.Dock="Right" FontSize="12" Foreground="#94A3B8"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusDetail" Margin="18,0" VerticalAlignment="Center" FontSize="13.5"
                               Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <ItemsControl x:Name="MetricsList" Grid.Row="2" Margin="-6,8,-6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,6,0,0" Padding="20,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Ellipse Width="10" Height="10" Fill="#A78BFA" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="Ventiladores de la GPU" FontSize="17" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                    </StackPanel>
                    <ItemsControl x:Name="FanList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,28,0"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                    <TextBlock x:Name="NoFans" Visibility="Collapsed" Foreground="#64748B" FontSize="13"
                               Text="La GPU no reporta RPM de ventiladores."/>
                    <TextBlock x:Name="FanNote" Visibility="Collapsed" Foreground="#94A3B8" FontSize="12.5"
                               TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="12" Foreground="#64748B"
                               Text="Iniciando sensores…" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
