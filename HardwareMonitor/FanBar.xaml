<UserControl x:Class="VibeWise.HardwareMonitor.FanBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,0,0,14">
        <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Right" Text="{Binding RpmText}" FontSize="13" FontWeight="SemiBold"
                       Foreground="#F1F5F9"/>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="13" Foreground="#CBD5E1"/>
        </DockPanel>
        <ProgressBar Style="{StaticResource Slim}" Margin="0,6,0,0"
                     Minimum="0" Maximum="{Binding Maximum}" Value="{Binding Rpm}"/>
    </StackPanel>
</UserControl>
