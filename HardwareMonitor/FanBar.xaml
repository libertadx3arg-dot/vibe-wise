<UserControl x:Class="VibeWise.HardwareMonitor.FanBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VibeWise.HardwareMonitor.Controls">
    <StackPanel Margin="0,0,0,14">
        <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Readout}" FontSize="14" FontWeight="SemiBold"
                       Foreground="#F1F5F9"/>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="14" Foreground="#CBD5E1"/>
        </DockPanel>
        <c:AnimatedBar Height="10" Margin="0,7,0,0" Value="{Binding Fraction}" Fill="{Binding Fill}"/>
    </StackPanel>
</UserControl>
